APP_NAME=Medical Records Backend
ENVIRONMENT=local
DATABASE_URL=sqlite:///./med_app.db
LOCAL_STORAGE_ROOT=.local_storage
DEV_AUTH_ENABLED=true
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
EXTRACTION_PROVIDER=mock
EXTRACTION_RUN_INLINE=true
MAX_UPLOAD_BYTES=15000000
# V1 slice flags. The code defaults every flag to false so a deployment enables
# only what it has evidence for. Local development turns on the shipped slices.
FEATURE_WEB_INGESTION_ENABLED=true
FEATURE_EXTRACTION_ENABLED=true
FEATURE_OBSERVATIONS_ENABLED=true
FEATURE_FEED_DRIVE_ENABLED=false
FEATURE_CHAT_ENABLED=false
