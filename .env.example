APP_NAME=Medical Records Backend
ENVIRONMENT=local
DATABASE_URL=sqlite:///./med_app.db
# Production runtime example:
# DATABASE_URL=postgresql+psycopg://med_app_api:<password>@<host>:5432/postgres
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres
MIGRATION_DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_SSL_MODE=require
LOCAL_STORAGE_ROOT=.local_storage
DEV_AUTH_ENABLED=true
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
EXTRACTION_PROVIDER=mock
EXTRACTION_RUN_INLINE=true
MAX_UPLOAD_BYTES=15000000
