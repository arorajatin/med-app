APP_NAME=Medical Records Backend
ENVIRONMENT=local
DATA_BACKEND=local
DATABASE_URL=sqlite:///./med_app.db
LOCAL_STORAGE_ROOT=.local_storage
# Development authentication takes the bearer value as a literal user id. It suits
# backend-only work and the test suite. Set it to false when running apps/web,
# which signs in with Google and sends Supabase access tokens; otherwise a token
# becomes the account key and each refresh looks like a different person.
DEV_AUTH_ENABLED=true
SUPABASE_URL=
# Publishable. apps/web needs the same value as VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
EXTRACTION_PROVIDER=mock
EXTRACTION_RUN_INLINE=true
MAX_UPLOAD_BYTES=15000000

# Hosted upload/storage settings. Generate a separate runtime.env with the
# fresh-project provisioning command in infra/supabase/README.md.
# Hosted mode requires verified Google/Supabase sign-in, a med_app_api DB login
# with sslmode=verify-full, and EXTRACTION_PROVIDER=disabled / RUN_INLINE=false.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=ap-southeast-1
SUPABASE_STORAGE_BUCKET=medical-records
SUPABASE_ATTESTATION_PATH=
PRODUCTION_DATA_ENABLED=false
# Set this only in the cleanup process, never the web client or API environment.
SUPABASE_CLEANUP_DATABASE_URL=
