# Sign-in. Both values are publishable and ship in the browser bundle: the anon
# key grants nothing on its own. Copy them from the Supabase dashboard under
# Project Settings, API. They are the same project the backend verifies tokens
# against, so SUPABASE_URL in the repository-root .env must match this URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. A deployed build calls the API directly and then needs CORS on the
# API. Local development leaves this empty and uses the dev server's /api proxy.
VITE_API_BASE_URL=

# Optional. The consent policy version recorded with each acceptance.
VITE_CONSENT_POLICY_VERSION=
