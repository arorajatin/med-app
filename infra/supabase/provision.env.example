# Keep a filled copy in .context/supabase/provision.env (chmod 600), never .env.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
# Copy the verified direct or Singapore session-pooler URI from this project's
# dashboard. Percent-encode the password. Supply the project CA if necessary.
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@db.PROJECT.supabase.co:5432/postgres?sslmode=verify-full
SUPABASE_ANON_KEY=
# Accepted HS256 signing secret, provisioning only. The API receives only
# short-lived object-scoped JWTs from a restricted database function.
SUPABASE_STORAGE_JWT_SECRET=
